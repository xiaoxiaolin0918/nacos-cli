# Nacos 连接配置（复制为本目录 .env 后填写；勿提交真实密钥）
# 示例：复制命令  copy .env.example .env

NACOS_SERVER=http://127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_NAMESPACE=
# 可选：API 前缀，默认 /nacos
NACOS_CONTEXT_PATH=/nacos

# Optional: override credentials file (default %APPDATA%/nacos-cli/credentials.json)
# NACOS_CREDENTIALS_PATH=
